---
import { planStore } from "../lib/plan";
import {
  type Activity,
  clashReason,
  COMPLETE_MESSAGE,
  describeActivity,
  optionStatus,
  progressLine,
} from "../lib/plan-store";
import { GRID_ROWS, gridPlacement, gridRow } from "../lib/week-grid";
import "../styles.css";

const planId = Astro.locals.planId;
const picks = planStore.listPicks(planId);
const progress = planStore.progress(planId);
const courses = planStore.listCourses();
const allActivities = planStore.listActivities();

const titleByCode = new Map(courses.map((c) => [c.code, c.title]));

// Group by course, then by activity type, preserving listActivities()'s
// order (seed/insertion order — DESIGN.md's course-list order), not an
// alphabetical one.
const courseOrder: string[] = [];
const byCourse = new Map<string, Activity[]>();
for (const activity of allActivities) {
  if (!byCourse.has(activity.courseCode)) {
    courseOrder.push(activity.courseCode);
    byCourse.set(activity.courseCode, []);
  }
  byCourse.get(activity.courseCode)!.push(activity);
}

// DESIGN.md "Lectures come first": "In each course, the lecture is listed
// first." A fixed type (exactly one group) sorts before every other type,
// otherwise insertion order is kept.
function groupByType(activities: Activity[]): [string, Activity[]][] {
  const order: string[] = [];
  const byType = new Map<string, Activity[]>();
  for (const activity of activities) {
    if (!byType.has(activity.type)) {
      order.push(activity.type);
      byType.set(activity.type, []);
    }
    byType.get(activity.type)!.push(activity);
  }
  const fixedFirst = [...order].sort((a, b) => {
    const aFixed = byType.get(a)!.some((act) => act.fixed);
    const bFixed = byType.get(b)!.some((act) => act.fixed);
    return aFixed === bFixed ? 0 : aFixed ? -1 : 1;
  });
  return fixedFirst.map((type) => [type, byType.get(type)!]);
}

const DAY_NAMES = ["", "Mon", "Tue", "Wed", "Thu", "Fri"];

function formatTime(min: number): string {
  const h = Math.floor(min / 60);
  const m = min % 60;
  return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
}

// Hour labels for the grid's time gutter, 08:00 through 20:00 — every label
// lines up with the row it names (the 20:00 label sits at the bottom of the
// last row rather than starting a nonexistent 49th one).
const HOURS = Array.from({ length: 13 }, (_, i) => 8 + i);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Clash-free class picker</title>
  </head>
  <body>
    <header class="site-header">
      <p class="site-title">Clash-free class picker</p>
      <p class="site-disclaimer">Student project · not an official ANU system</p>
    </header>
    <nav aria-label="site">
      <a href="/">Plan</a>
      <a href="/about">About</a>
    </nav>
    <main class="plan">
      <h1>Your plan</h1>
      <p>Demo timetable — times are invented.</p>

      <div id="plan-progress" class="progress">
        <p class="progress-line">{progressLine(progress)}</p>
        {
          progress.complete ? (
            <p class="progress-complete">{COMPLETE_MESSAGE}</p>
          ) : (
            <form class="fill-form" data-action="fill">
              <button type="submit">Fill the rest for me</button>
            </form>
          )
        }
      </div>
      <p id="plan-status" role="status" aria-live="polite"></p>

      <div id="plan-layout" class="plan-layout">
        <section class="course-list" aria-label="Courses">
          {
            courseOrder.map((code) => (
              <section class="course">
                <h2>
                  {code} {titleByCode.get(code)}
                </h2>
                {groupByType(byCourse.get(code)!).map(([type, options]) => (
                  <div class="activity-type">
                    <h3>{type}</h3>
                    <ul class="options">
                      {options.map((activity) => {
                        const status = optionStatus(picks, activity);
                        if (status === "fixed") {
                          return (
                            <li class="option" data-status="fixed">
                              <div class="option-form">
                                <span class="option-time">
                                  {DAY_NAMES[activity.day]} {formatTime(activity.startMin)}–
                                  {formatTime(activity.endMin)}
                                </span>
                                <span class="option-group">Group {activity.group}</span>
                                <span class="option-label">Fixed · lecture</span>
                              </div>
                            </li>
                          );
                        }
                        const picked = status === "picked";
                        const clash = typeof status === "object" ? status : null;
                        const reason = clash ? clashReason(clash.clashesWith) : null;
                        return (
                          <li class="option" data-status={picked ? "picked" : clash ? "clashes" : "fits"}>
                            <form
                              class="option-form"
                              data-activity-id={activity.id}
                              data-action={picked ? "remove" : "pick"}
                              data-day={activity.day}
                              data-start={activity.startMin}
                              data-end={activity.endMin}
                              data-label={describeActivity(activity)}
                              data-reason={reason ?? undefined}
                              data-clash-id={clash ? clash.clashesWith.id : undefined}
                            >
                              <span class="option-time">
                                {DAY_NAMES[activity.day]} {formatTime(activity.startMin)}–{formatTime(activity.endMin)}
                              </span>
                              <span class="option-group">Group {activity.group}</span>
                              {picked ? (
                                <button type="submit">Remove</button>
                              ) : (
                                <span class="pick-target">
                                  <button type="submit" disabled={clash !== null}>
                                    Pick
                                  </button>
                                </span>
                              )}
                              <span class="option-label">{picked ? "Picked" : reason ?? "fits"}</span>
                            </form>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </section>
            ))
          }
        </section>

        <section class="week" aria-label="Your week">
          <h2>Your week</h2>
          <div class="week-grid" aria-hidden="true">
            <div class="week-grid-header">
              <div class="week-grid-corner"></div>
              {DAY_NAMES.slice(1).map((day) => (
                <div class="week-grid-day">{day}</div>
              ))}
            </div>
            <div class="week-grid-body" style={`grid-template-rows: repeat(${GRID_ROWS}, 1fr);`}>
              {HOURS.map((h) => (
                <div
                  class="week-grid-hour"
                  style={`grid-column: 1; grid-row: ${h === 20 ? GRID_ROWS : gridRow(h * 60)} / span 1; align-self: ${h === 20 ? "end" : "start"};`}
                >
                  {String(h).padStart(2, "0")}:00
                </div>
              ))}
              {picks.map((activity) => (
                <div
                  data-activity-id={activity.id}
                  class={`week-grid-event ${activity.fixed ? "week-grid-event-fixed" : "week-grid-event-picked"}`}
                  style={`grid-column: ${gridPlacement(activity).gridColumn}; grid-row: ${gridPlacement(activity).gridRow};`}
                >
                  {activity.courseCode} {activity.type} {activity.group}
                  <br />
                  {formatTime(activity.startMin)}–{formatTime(activity.endMin)}
                </div>
              ))}
            </div>
          </div>
          <ul class="week-list">
            {[1, 2, 3, 4, 5].map((day) => {
              const dayPicks = picks
                .filter((a) => a.day === day)
                .sort((a, b) => a.startMin - b.startMin);
              return (
                <li>
                  <h3>{DAY_NAMES[day]}</h3>
                  {dayPicks.length === 0 ? (
                    <p class="week-list-empty">Nothing picked</p>
                  ) : (
                    <ul>
                      {dayPicks.map((activity) => (
                        <li class={activity.fixed ? "week-list-event-fixed" : "week-list-event-picked"}>
                          {activity.courseCode} {activity.type} {activity.group} ({formatTime(activity.startMin)}–
                          {formatTime(activity.endMin)})
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      </div>
    </main>
    <script>
      // Progressive enhancement, no framework: every pick/remove/fill is a
      // real <button> in a <form>. Listeners are delegated from <main>, so
      // they keep working after #plan-progress and #plan-layout are swapped
      // for the server's freshly rendered copies (DESIGN.md "The one flow",
      // step 9). #plan-status sits outside both, so the live region is never
      // replaced and its announcements aren't lost.
      import { gridPlacement } from "../lib/week-grid";

      const main = document.querySelector<HTMLElement>("main.plan")!;
      const status = document.querySelector<HTMLElement>("#plan-status");
      const REGIONS = ["plan-progress", "plan-layout"];

      function say(text: string): void {
        if (!status) return;
        status.textContent = "";
        requestAnimationFrame(() => (status.textContent = text));
      }

      function buttons(): HTMLButtonElement[] {
        return REGIONS.flatMap((id) => [...(document.getElementById(id)?.querySelectorAll("button") ?? [])]);
      }

      function nearestEnabled(index: number): HTMLButtonElement | null {
        const all = buttons();
        for (let d = 0; d < all.length; d++) {
          for (const b of [all[index + d], all[index - d]]) if (b && !b.disabled) return b;
        }
        return null;
      }

      async function refresh(activityId: string | undefined, index: number): Promise<void> {
        const html = await (await fetch(location.pathname)).text();
        const fresh = new DOMParser().parseFromString(html, "text/html");
        const x = window.scrollX;
        const y = window.scrollY;
        for (const id of REGIONS) {
          const next = fresh.getElementById(id);
          if (next) document.getElementById(id)?.replaceWith(next);
        }
        window.scrollTo(x, y);
        const same = activityId
          ? document.querySelector<HTMLButtonElement>(`form.option-form[data-activity-id="${activityId}"] button`)
          : null;
        (same && !same.disabled ? same : nearestEnabled(index))?.focus({ preventScroll: true });
      }

      main.addEventListener("submit", async (event) => {
        const form = event.target as HTMLFormElement;
        if (!form.matches("form.option-form, form.fill-form")) return;
        event.preventDefault();
        clearPreview();
        const index = buttons().indexOf(form.querySelector("button")!);
        const { action, activityId } = form.dataset;

        const response =
          action === "fill"
            ? await fetch("/api/fill", { method: "POST" })
            : action === "remove"
              ? await fetch(`/api/picks/${activityId}`, { method: "DELETE" })
              : await fetch("/api/picks", {
                  method: "POST",
                  headers: { "content-type": "application/json" },
                  body: JSON.stringify({ activityId: Number(activityId) }),
                });

        if (response.ok) {
          await refresh(activityId, index);
          say("Saved.");
          return;
        }
        const body = await response.json().catch(() => null);
        say(body?.error ?? `request failed (${response.status})`);
      });

      // DESIGN.md "Preview before you pick". The preview block is absolutely
      // positioned inside its grid area, so it never moves or resizes the
      // grid. On the phone layout the grid is display:none, so no preview.
      let previewFor: Element | null = null;

      function clearPreview(): void {
        previewFor = null;
        document.querySelectorAll(".week-grid-preview").forEach((el) => el.remove());
        document.querySelectorAll(".week-grid-event-clash").forEach((el) => el.classList.remove("week-grid-event-clash"));
      }

      function showPreview(target: Element): void {
        if (target === previewFor) return;
        clearPreview();
        const form = target.closest<HTMLFormElement>("form.option-form");
        const body = document.querySelector<HTMLElement>(".week-grid-body");
        if (!form || !body || form.dataset.action !== "pick") return;
        previewFor = target;
        const { day, start, end, label, reason, clashId } = form.dataset;
        const block = document.createElement("div");
        block.className = "week-grid-preview";
        const place = gridPlacement({ day: Number(day), startMin: Number(start), endMin: Number(end) });
        block.style.gridColumn = place.gridColumn;
        block.style.gridRow = place.gridRow;
        block.textContent = label ?? "";
        if (reason) {
          const why = document.createElement("span");
          why.className = "week-grid-preview-reason";
          why.textContent = reason;
          block.append(why);
        }
        body.append(block);
        if (clashId) body.querySelector(`[data-activity-id="${clashId}"]`)?.classList.add("week-grid-event-clash");
      }

      // Hover lands on .pick-target, not the button: a disabled (clashing)
      // button gets pointer-events: none, so its wrapper still sees the mouse.
      main.addEventListener("mouseover", (event) => {
        const target = (event.target as Element).closest(".pick-target");
        if (target) showPreview(target);
      });
      main.addEventListener("mouseout", (event) => {
        const target = (event.target as Element).closest(".pick-target");
        const into = event.relatedTarget as Node | null;
        if (target && target === previewFor && !(into && target.contains(into))) clearPreview();
      });
      main.addEventListener("focusin", (event) => {
        const target = (event.target as Element).closest(".pick-target");
        if (target) showPreview(target);
      });
      main.addEventListener("focusout", (event) => {
        const target = (event.target as Element).closest(".pick-target");
        if (target && target === previewFor) clearPreview();
      });
    </script>
    <style>
      .plan {
        max-width: none;
        width: min(100%, 70rem);
      }

      /* DESIGN.md "Progress": always at the top, in words. */
      .progress {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1rem;
        margin-block: 1rem 0;
      }

      .progress-line,
      .progress-complete {
        margin: 0;
        font-weight: 600;
      }

      .fill-form {
        margin: 0;
      }

      /* Reserve the status line's height so "Saved." doesn't push the page
         down when it appears. */
      #plan-status {
        min-height: 1.6em;
        margin-block: 0.5rem 1rem;
      }

      .plan-layout {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .course-list,
      .week {
        min-width: 0;
      }

      .course h2 {
        margin-bottom: 0.25rem;
      }

      .activity-type h3 {
        margin-block: 0.5rem 0.25rem;
        font-size: 1rem;
        color: var(--anu-unigrey);
      }

      .options {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .option {
        margin-block-end: 0.4rem;
        padding: 0.15rem 0.4rem;
      }

      .option-form {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
      }

      .option-time {
        min-width: 11rem;
      }

      .option-group {
        min-width: 6rem;
      }

      /* DESIGN.md "Look", Options: "picked" = gold-tint row + "Picked" text. */
      .option[data-status="picked"] {
        background: var(--anu-gold-tint);
      }

      .option[data-status="picked"] .option-label {
        color: var(--anu-unigrey);
        font-weight: 600;
      }

      /* Fixed classes read the same as "picked" — they're in the plan too,
         just with nothing to remove. */
      .option[data-status="fixed"] {
        background: var(--anu-gold-tint);
      }

      .option[data-status="fixed"] .option-label {
        color: var(--anu-unigrey);
        font-weight: 600;
      }

      /* DESIGN.md "Look", Options: clashing = greyed text (--disabled-grey
         passes WCAG AA on white, 5.74:1), disabled button, reason in words —
         colour is never the only signal. */
      .option[data-status="clashes"] {
        color: var(--disabled-grey);
      }

      .option[data-status="clashes"] .option-label {
        color: var(--disabled-grey);
      }

      .week-grid {
        display: grid;
        border: 1px solid var(--anu-unigrey);
      }

      .week-grid-header {
        display: grid;
        grid-template-columns: 3rem repeat(5, 1fr);
      }

      .week-grid-day {
        text-align: center;
        font-weight: 600;
        padding-block: 0.25rem;
        border-inline-start: 1px solid var(--anu-unigrey);
      }

      .week-grid-body {
        position: relative;
        display: grid;
        grid-template-columns: 3rem repeat(5, 1fr);
        grid-auto-flow: dense;
        min-height: 30rem;
      }

      /* Time gutter: one label per hour line, right-aligned against the
         3rem column so it reads like an axis next to the grid. */
      .week-grid-hour {
        grid-column: 1;
        padding-inline-end: 0.35rem;
        font-size: 0.7rem;
        line-height: 1;
        color: var(--anu-unigrey);
        text-align: right;
      }

      .week-grid-event {
        margin: 1px;
        padding: 0.25rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.25rem;
        overflow: hidden;
      }

      /* DESIGN.md "Look", Week view: lectures = black block, white text. */
      .week-grid-event-fixed {
        background: var(--anu-black);
        color: var(--anu-white);
        border: 1px solid var(--anu-black);
      }

      /* Picked tutorials/crits = gold-tint block with a 4px gold left
         border, Unigrey text. */
      .week-grid-event-picked {
        background: var(--anu-gold-tint);
        border: 1px solid var(--anu-gold-tint);
        border-left: 4px solid var(--anu-gold);
        color: var(--anu-unigrey);
      }

      .week-list {
        list-style: none;
        padding: 0;
        display: none;
      }

      /* The day's picks list had no list-style of its own, so the browser
         default bullet showed up — but only visibly on light backgrounds;
         a white marker on the black lecture blocks blended into the page's
         white background instead. Same rule for every item either way. */
      .week-list ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .week-list h3 {
        margin-block-end: 0.25rem;
      }

      .week-list-empty {
        color: var(--disabled-grey);
        margin-block: 0 1rem;
      }

      .week-list-event-fixed {
        background: var(--anu-black);
        color: var(--anu-white);
        padding: 0.15rem 0.4rem;
      }

      .week-list-event-picked {
        background: var(--anu-gold-tint);
        border-left: 4px solid var(--anu-gold);
        color: var(--anu-unigrey);
        padding: 0.15rem 0.4rem 0.15rem 0.25rem;
      }

      /* Layout switch, DESIGN.md "Layout": grid beside the list on desktop,
         list below the list on phone-width screens, no horizontal scroll. */
      @media (min-width: 701px) {
        .plan-layout {
          flex-direction: row;
          align-items: flex-start;
        }

        .course-list {
          flex: 1 1 28rem;
        }

        .week {
          flex: 1 1 32rem;
          position: sticky;
          top: 1rem;
        }
      }

      @media (max-width: 700px) {
        .week-grid {
          display: none;
        }

        .week-list {
          display: block;
        }
      }
    </style>
  </body>
</html>
